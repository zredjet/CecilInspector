<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>cecil-inspector</AssemblyName>
    <RootNamespace>CecilInspector</RootNamespace>
    <Version>0.5.0</Version>
    <Authors>zredjet</Authors>
    <Copyright>Copyright (c) 2026 zredjet</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Mono.Cecil based metadata and IL search for .NET assemblies without loading them.</Description>
    <!-- Only for the LibraryImport source generator (console virtual-terminal switch on Windows). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CecilInspector.Tests" />
  </ItemGroup>
</Project>
